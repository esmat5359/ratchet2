# Copy to .env.local and adjust.  Every value is optional.
# The deployed Ratchet contract on GenLayer Studionet:
VITE_CONTRACT_ADDRESS=0xA0a4fB98Da65a8e43B7b8bccb8431FEebEd0AEEe
# Override the Studionet RPC (default https://studio.genlayer.com/api):
# VITE_RPC_URL=https://studio.genlayer.com/api
# Base path when the site is hosted in a sub-folder, e.g. GitHub Pages project sites:
# VITE_BASE=/ratchet/
